html_content = """<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Autorización de Pedidos</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --panel-bg: #1e293b;
            --border-color: #334155;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --btn-blue: #3b82f6;
            --btn-blue-hover: #2563eb;
            --btn-red: #ef4444;
            --btn-red-hover: #dc2626;
            --btn-dark: #334155;
            --btn-dark-hover: #475569;
            --badge-orange: #d97706;
        }
        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }
        .container {
            width: 100%;
            max-width: 800px;
            background-color: var(--bg-color);
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .header h1 {
            font-size: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0;
        }
        .btn-icon {
            background-color: var(--panel-bg);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 8px 12px;
            border-radius: 6px;
            cursor: pointer;
        }
        .panel {
            background-color: var(--panel-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
        }
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 15px;
        }
        .form-group label {
            display: block;
            font-size: 12px;
            color: var(--text-muted);
            margin-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .form-control {
            width: 100%;
            background-color: var(--bg-color);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 10px;
            border-radius: 6px;
            box-sizing: border-box;
            font-size: 14px;
        }
        .form-control:focus {
            outline: none;
            border-color: var(--btn-blue);
        }
        .badge {
            background-color: var(--badge-orange);
            color: white;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 14px;
            display: inline-block;
            margin-top: 5px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        th {
            text-align: left;
            padding: 12px 10px;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-muted);
            font-weight: normal;
            font-size: 14px;
        }
        td {
            padding: 12px 10px;
            border-bottom: 1px solid var(--border-color);
            font-size: 14px;
        }
        .input-qty {
            width: 70px;
            background-color: var(--bg-color);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 6px;
            border-radius: 4px;
            text-align: center;
        }
        .empty-state {
            text-align: center;
            padding: 30px;
            color: var(--text-muted);
            font-size: 14px;
        }
        .btn {
            display: block;
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 6px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            margin-bottom: 10px;
            color: white;
            text-align: center;
            transition: opacity 0.2s;
        }
        .btn:hover { opacity: 0.9; }
        .btn-primary { background-color: var(--btn-blue); }
        .btn-danger { background-color: var(--btn-red); }
        .btn-secondary { background-color: var(--btn-dark); border: 1px solid var(--border-color); }
        
        #loading { display: none; color: var(--btn-blue); font-size: 14px; margin-left: 10px; }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <h1>📦 Autorización de Pedidos <span id="loading">Cargando...</span></h1>
        <button class="btn-icon" onclick="cargarPendientes()">🔄</button>
    </div>

    <div class="panel">
        <div class="grid-2">
            <div class="form-group">
                <label>Solicitud (Pendientes):</label>
                <select id="selectPedidos" class="form-control" onchange="seleccionarPedido()">
                    <option value="">Sin pendientes</option>
                </select>
            </div>
            <div class="form-group">
                <label>Fecha de consulta:</label>
                <input type="text" id="fechaConsulta" class="form-control" readonly value="-">
            </div>
            <div class="form-group">
                <label>Usuario (Técnico):</label>
                <input type="text" id="usuarioTecnico" class="form-control" readonly value="-">
            </div>
            <div class="form-group">
                <label>Estado:</label><br>
                <span class="badge">Al día</span>
            </div>
        </div>
    </div>

    <div id="tableContainer">
        <table>
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Detalle</th>
                    <th>Solicitado</th>
                    <th>Autorizado</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody id="tablaItems">
                <tr><td colspan="5" class="empty-state">No hay solicitudes pendientes asignadas</td></tr>
            </tbody>
        </table>
    </div>

    <button class="btn btn-primary" onclick="autorizarPedido()">📝 Autorizar Pedido</button>
    <button class="btn btn-danger" onclick="anularPedido()">🚫 Anular Pedido Completo</button>
    <button class="btn btn-secondary">⬅️ Volver al Menú</button>
</div>

<script>
    // Configuración
    const API_URL = "https://script.google.com/macros/s/AKfycbytHjsAF6wlmcbEzRIDO6D6i7RSe--B7VU5_w9wuPIQ9uZiNAtCkw_dkulzigpbo1-GEQ/exec"; // IMPORTANTE: Reemplazar por tu URL de despliegue
    const usernameActual = localStorage.getItem("username") || ""; 

    let currentItems = [];

    document.addEventListener("DOMContentLoaded", () => {
        cargarPendientes();
    });

    function showLoading(show) {
        document.getElementById('loading').style.display = show ? 'inline' : 'none';
    }

    async function cargarPendientes() {
        showLoading(true);
        try {
            const response = await fetch(`${API_URL}?action=listarPendientes&username=${usernameActual}`);
            const data = await response.json();
            
            const select = document.getElementById("selectPedidos");
            select.innerHTML = '<option value="">Selecciona una solicitud...</option>';
            
            if (data && data.length > 0) {
                data.forEach(id => {
                    const option = document.createElement("option");
                    option.value = id;
                    option.textContent = `Pedido #${id}`;
                    select.appendChild(option);
                });
            } else {
                select.innerHTML = '<option value="">Sin pendientes</option>';
                limpiarFormulario();
            }
        } catch (error) {
            console.error("Error al cargar pendientes:", error);
        } finally {
            showLoading(false);
        }
    }

    async function seleccionarPedido() {
        const id = document.getElementById("selectPedidos").value;
        if (!id) {
            limpiarFormulario();
            return;
        }

        showLoading(true);
        try {
            const response = await fetch(`${API_URL}?action=obtenerPedido&id=${id}`);
            const data = await response.json();
            
            document.getElementById("fechaConsulta").value = data.fecha || "-";
            document.getElementById("usuarioTecnico").value = data.usuario || "-";
            currentItems = data.items || [];
            
            renderTabla();
        } catch (error) {
            console.error("Error al obtener pedido:", error);
        } finally {
            showLoading(false);
        }
    }

    function renderTabla() {
        const tbody = document.getElementById("tablaItems");
        tbody.innerHTML = "";

        if (currentItems.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="empty-state">No hay solicitudes pendientes asignadas</td></tr>';
            return;
        }

        currentItems.forEach((item, index) => {
            const tr = document.createElement("tr");
            tr.innerHTML = `
                <td>${item.codigo}</td>
                <td>${item.detalle}</td>
                <td>${item.solicitado}</td>
                <td>
                    <input type="number" id="cant_${item.codigo}" class="input-qty" value="${item.solicitado}" min="0">
                </td>
                <td>-</td>
            `;
            tbody.appendChild(tr);
        });
    }

    function limpiarFormulario() {
        document.getElementById("fechaConsulta").value = "-";
        document.getElementById("usuarioTecnico").value = "-";
        document.getElementById("tablaItems").innerHTML = '<tr><td colspan="5" class="empty-state">No hay solicitudes pendientes asignadas</td></tr>';
        currentItems = [];
    }

    async function autorizarPedido() {
        const id = document.getElementById("selectPedidos").value;
        if (!id || currentItems.length === 0) {
            alert("Selecciona un pedido válido primero.");
            return;
        }

        const itemsToSend = currentItems.map(item => ({
            codigo: item.codigo,
            cantidad: parseInt(document.getElementById(`cant_${item.codigo}`).value) || 0
        }));

        const payload = {
            action: "procesarAutorizacion",
            id: id,
            items: itemsToSend
        };

        showLoading(true);
        try {
            const response = await fetch(API_URL, {
                method: "POST",
                body: JSON.stringify(payload),
                headers: {
                    "Content-Type": "text/plain;charset=utf-8"
                }
            });
            const result = await response.json();
            
            if (result.success) {
                alert("✅ " + result.message);
                cargarPendientes(); 
                limpiarFormulario();
            } else {
                alert("❌ Error: " + result.message);
            }
        } catch (error) {
            alert("Error de red al autorizar.");
            console.error(error);
        } finally {
            showLoading(false);
        }
    }

    async function anularPedido() {
        const id = document.getElementById("selectPedidos").value;
        if (!id) return;
        
        if(confirm("¿Estás seguro de anular todo el pedido (se autorizará con cantidad 0)?")) {
            currentItems.forEach(item => {
                document.getElementById(`cant_${item.codigo}`).value = 0;
            });
            await autorizarPedido();
        }
    }
</script>
</body>
</html>"""

with open("autorizacion_pedidos.html", "w", encoding="utf-8") as f:
    f.write(html_content)

print("[file-tag: autorizacion_pedidos.html]")
